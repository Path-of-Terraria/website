{
	"name": "pot-website",
	"description": "Website for Path of Terraria",
	"version": "0.0.1",
	"packageManager": "pnpm@10.27.0",
	"scripts": {
		"dev": "vite dev",
		"dependencies:check": "pnpm dlx npm-check-updates",
		"dependencies:update": "pnpm dlx npm-check-updates -u",
		"dependencies:update:patch": "pnpm dlx npm-check-updates -u --target patch",
		"dependencies:update:minor": "pnpm dlx npm-check-updates -u --target minor",
		"build": "vite build",
		"start": "vite --port 80 --host",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
    "dependencies": {
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.2.2"
    },
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^25.0.3",
		"axios": "^1.13.2",
		"flowbite": "^3.1.2",
		"flowbite-svelte": "^1.31.0",
		"flowbite-svelte-icons": "^2.3.0",
		"openapi-typescript": "^7.10.1",
		"postcss": "^8.5.6",
		"svelte": "5.46.1",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "7.3.0"
	},
	"type": "module"
}
